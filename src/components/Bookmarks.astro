<section id="bookmark-manager" aria-labelledby="bookmarks-title">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="https://example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p class="hint">Paste a URL to create a short, shareable <code>mona-</code> slug.</p>
  <p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" hidden>
    <h2 id="bookmarks-title" class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<style is:global>
  #bookmark-manager form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem;
    margin: 1.75rem 0 0.6rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }
  #bookmark-manager .field { flex: 1 1 16rem; }
  #bookmark-manager input { min-height: 2.8rem; }
  #bookmark-manager form button { min-height: 2.8rem; }
  #bookmark-manager .hint { margin-bottom: 1rem; }
  #bookmark-manager .status {
    min-height: 1.5rem;
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  #bookmark-manager .status[data-error="true"] { color: #dc2626; }
  #bookmark-manager #list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 1.5rem 0 0.75rem;
  }
  #bookmark-manager #list-header[hidden] { display: none; }
  #bookmark-manager .list-title {
    margin: 0;
    font-family: var(--font-head);
    font-size: 1rem;
  }
  #bookmark-manager .clear,
  #bookmark-manager .copy {
    border: 1px solid var(--border);
    background: transparent;
    color: inherit;
    font-size: 0.8rem;
    font-weight: 500;
  }
  #bookmark-manager .clear { padding: 0.35rem 0.7rem; }
  #bookmark-manager ul {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #bookmark-manager li.bookmark {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    background: color-mix(in srgb, currentColor 3%, transparent);
  }
  #bookmark-manager .url {
    min-width: 0;
    flex: 1 1 12rem;
    overflow-wrap: anywhere;
  }
  #bookmark-manager .separator { white-space: pre; color: var(--muted); }
  #bookmark-manager .slug {
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    font-family: var(--font-body);
    font-size: 0.85rem;
  }
  #bookmark-manager .copy { margin-left: auto; padding: 0.3rem 0.6rem; }
  #bookmark-manager .empty {
    margin: 0;
    padding: 1.5rem;
    border: 1px dashed var(--border);
    border-radius: 0.85rem;
    color: var(--muted);
    text-align: center;
  }
  #bookmark-manager button:hover { filter: brightness(1.05); }
  @media (max-width: 30rem) {
    #bookmark-manager form { padding: 1rem; }
    #bookmark-manager form button { width: 100%; }
  }
</style>

<script>
  import { formatBookmark, normalizeUrl, parseBookmarks } from '../lib/bookmarks.js';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('bookmark-status');

  function showStatus(message, isError = false) {
    if (!status) return;
    status.textContent = message;
    status.dataset.error = String(isError);
  }

  function loadBookmarks() {
    try {
      return parseBookmarks(window.localStorage.getItem(storageKey));
    } catch {
      return [];
    }
  }

  function saveBookmarks(bookmarks) {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(bookmarks));
      return true;
    } catch {
      return false;
    }
  }

  function createSlug(existingBookmarks) {
    const alphabet = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
    let slug;
    do {
      const random = new Uint8Array(4);
      window.crypto.getRandomValues(random);
      slug = `mona-${Array.from(random, (value) => alphabet[value % alphabet.length]).join('')}`;
    } while (existingBookmarks.some((bookmark) => bookmark.slug === slug));
    return slug;
  }

  function render(bookmarks) {
    if (!list || !emptyState || !listHeader) return;

    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const row = document.createElement('li');
      row.className = 'bookmark';
      row.setAttribute('aria-label', formatBookmark(bookmark));

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await window.navigator.clipboard.writeText(bookmark.slug);
          showStatus(`Copied ${bookmark.slug}`);
        } catch {
          showStatus('Could not access the clipboard.', true);
        }
      });

      row.append(link, separator, slug, copyButton);
      list.append(row);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      try {
        const input = form.elements.namedItem('url');
        if (!(input instanceof HTMLInputElement)) {
          throw new Error('The bookmark URL field is unavailable.');
        }

        const url = normalizeUrl(input.value);
        const bookmarks = loadBookmarks();
        const updatedBookmarks = [...bookmarks, { url, slug: createSlug(bookmarks) }];
        render(updatedBookmarks);

        if (!saveBookmarks(updatedBookmarks)) {
          showStatus('Bookmark added, but browser storage is unavailable.', true);
          return;
        }

        input.value = '';
        showStatus('Bookmark saved.');
      } catch (error) {
        showStatus(error instanceof Error ? error.message : 'Could not add that bookmark.', true);
      }
    });
  }

  document.getElementById('clear-all')?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    try {
      window.localStorage.removeItem(storageKey);
      render([]);
      showStatus('All bookmarks cleared.');
    } catch {
      showStatus('Could not clear bookmarks from browser storage.', true);
    }
  });

  render(loadBookmarks());
</script>
